  "calculation": {
    "busOneCreativeFormula": "mediaLow = physicalVehicleCount * confirmedBillingMonths * mediaPriceLowCny; mediaHigh = physicalVehicleCount * confirmedBillingMonths * mediaPriceHighCny; productionLow = physicalVehicleCount * productionLowCny; productionHigh = physicalVehicleCount * productionHighCny; subtotalLow/High = mediaLow/High + productionLow/High",
    "metroOneCreativeFormula": "mediaLow/High = physicalPointCount * confirmedBillingMonths * mediaPriceLow/HighCny; production = 100 * sum(actualPrintAreaSquareMeters of selected points); subtotalLow/High = mediaLow/High + production",
    "repeatProductionRule": "同一素材同一物理媒体在连续刊期内制作一次；换稿、换车、换点、重新施工等应另行核实制作轮次，不能自动免除或重复按月计入",
    "zeroQuantityRule": "物理媒体数量为0时，该资源媒介费与本次制作费均为0；不要保留幽灵制作费",
